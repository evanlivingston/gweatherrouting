<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24" />
  <object class="GtkMenu" id="orc-list-menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkMenuItem" id="download-orc-menu-item">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Download</property>
        <signal name="activate" handler="on_orc_download" swapped="no" />
        <property name="sensitive">False</property>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="orc-list-store">
    <columns>
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gboolean" />
    </columns>
  </object>
  <object class="GtkMenu" id="polar-manager-menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkMenuItem" id="remove-polar-menu-item">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Remove</property>
        <signal name="activate" handler="on_local_polar_remove" swapped="no" />
        <property name="sensitive">False</property>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="polar-manager-store">
    <columns>
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gchararray" />
      <column type="gboolean" />
    </columns>
  </object>
  <object class="GtkBox" id="polar-manager-content">
    <property name="visible">True</property>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin">8</property>
    <child>
      <object class="GtkNotebook" id="manager-tabs">
        <property name="visible">True</property>
        <property name="show-border">False</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="open-polar-button">
                    <property name="visible">True</property>
                    <property name="label">Open polar…</property>
                    <property name="sensitive">True</property>
                    <signal name="clicked" handler="on_open" swapped="no" />
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="remove-polar-button">
                    <property name="visible">True</property>
                    <property name="label">Remove</property>
                    <property name="sensitive">False</property>
                    <signal name="clicked" handler="on_local_polar_remove" swapped="no" />
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="local-treeview">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="model">polar-manager-store</property>
                    <property name="search-column">1</property>
                    <property name="show-expanders">False</property>
                    <signal name="button-press-event" handler="on_local_polar_click" swapped="no" />
                    <child internal-child="selection">
                      <object class="GtkTreeSelection">
                        <signal name="changed" handler="on_local_polar_select" swapped="no" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title" translatable="yes">Enabled</property>
                        <child>
                          <object class="GtkCellRendererToggle">
                            <signal name="toggled" handler="on_polar_toggle" swapped="no" />
                          </object>
                          <attributes>
                            <attribute name="active">4</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title" translatable="yes">Filename</property>
                        <property name="reorderable">True</property>
                        <property name="sort-column-id">0</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title" translatable="yes">Sail number</property>
                        <property name="reorderable">True</property>
                        <property name="sort-column-id">1</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">1</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title" translatable="yes">Name</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">2</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title" translatable="yes">Type</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">3</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="hscrollbar-policy">automatic</property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
              </packing>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">Local polars</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkSearchEntry" id="orc-search">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="placeholder-text">Search polars...</property>
                <signal name="search-changed" handler="on_orc_search_changed" swapped="no" />
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="orc-treeview">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="model">orc-list-store</property>
                    <property name="search-column">0</property>
                    <property name="show-expanders">False</property>
                    <property name="tooltip-column">0</property>
                    <signal name="button-press-event" handler="on_orc_click" swapped="no" />
                    <child internal-child="selection">
                      <object class="GtkTreeSelection">
                        <signal name="changed" handler="on_orc_select" swapped="no" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="Sail">
                        <property name="title" translatable="yes">Sail number</property>
                        <property name="reorderable">True</property>
                        <property name="sort-indicator">True</property>
                        <property name="sort-column-id">0</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">0</attribute>
                            <attribute name="sensitive">3</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="Name">
                        <property name="title" translatable="yes">Name</property>
                        <property name="reorderable">True</property>
                        <property name="sort-indicator">True</property>
                        <property name="sort-column-id">1</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">1</attribute>
                            <attribute name="sensitive">3</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="Type">
                        <property name="title" translatable="yes">Type</property>
                        <property name="reorderable">True</property>
                        <property name="sort-indicator">True</property>
                        <property name="sort-column-id">2</property>
                        <child>
                          <object class="GtkCellRendererText" />
                          <attributes>
                            <attribute name="text">2</attribute>
                            <attribute name="sensitive">3</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="download-orc-button">
                <property name="visible">True</property>
                <property name="label">Download selected polar</property>
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_orc_download" swapped="no" />
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label">ORC catalog</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
      </packing>
    </child>
    <child>
      <object class="GtkProgressBar" id="download-progress">
        <property name="can-focus">False</property>
        <property name="no-show-all">True</property>
        <property name="show-text">True</property>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
      </packing>
    </child>
  </object>
</interface>
